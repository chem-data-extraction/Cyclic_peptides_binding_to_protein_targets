{
  "web_extraction_version": "0.1.0",
  "output_records_file": "data/extracted/rcsb_metadata.csv",
  "script": "scripts/extract_rcsb.py",
  "input_pages": [
    {
      "source_id": "db_rcsb_pdb",
      "page_id": "rcsb_data_api_entry",
      "url": "https://data.rcsb.org/rest/v1/core/entry/{}",
      "access_date": "2026-05-29",
      "access_status": "open_access",
      "robots_notes": "Official RCSB PDB Data API for programmatic access. No explicit rate limit, but implement delays (e.g., 1 request/sec) to be respectful.",
      "selection_reason": "Retrieve comprehensive structural metadata (title, method, resolution, organism, UniProt ID) to enrich cyclic peptide records.",
      "page_type": "api_endpoint",
      "expected_content": "JSON object containing core entry information, including experimental method, resolution, source organism, citation data.",
      "parser_plan": {
        "tool": "requests",
        "response_type": "json",
        "url_params": {
          "pdb_id": "variable_from_pdb_list"
        },
        "selectors": {
          "title": "struct.title",
          "method": "exptl.method",
          "resolution": "refine.ls_d_res_high",
          "organism": "entity_src_gen.pdbx_gene_src_scientific_name",
          "uniprot_id": "rcsb_polymer_entity_container_identifiers.reference_sequence_identifiers[0].database_accession",
          "deposition_authors": "citation.rcsb_authors",
          "pdb_doi": "doi",
          "status": "rcsb_accession_info.status"
        }
      },
      "raw_snapshot_path": "data/raw/web/rcsb_entries/{pdb_id}.json",
      "extraction_status": "completed"
    }
  ]
}