{
  "web_extraction_version": "0.1.0",
  "output_records_file": "data/extracted/web_extracted_records.csv",
  "script": "scripts/extract_web.py",
  "input_pages": [
    {
      "source_id": "rcsb_pdb",
      "page_id": "pdb_entry_details",
      "url": "https://www.rcsb.org/structure/{}",
      "access_date": "2026-05-29",
      "access_status": "open_access",
      "robots_notes": "PDBe API is designed for programmatic access; no rate limit specified, but use responsibly.",
      "selection_reason": "Additional metadata for PDB records: peptide sequences, Uniprot ID, authors, publications.",
      "page_type": "api_endpoint",
      "expected_content": "JSON with a complete description of the structure, molecules, sequences",
      "parser_plan": {
        "tool": "requests",
        "response_type": "json",
        "url_params": {
          "pdb_id": "variable_from_file"
        },
        "selectors": {
          "title": "title",
          "target_name": "molecules[0].name",
          "target_organism": "molecules[0].source.organism.scientific",
          "method": "experimental_method",
          "resolution": "resolution",
          "peptide_sequence": "molecules[0].sequence",
          "uniprot_id": "molecules[0].uniprot_ids[0]",
          "publication": "citations[0].doi",
          "authors": "citations[0].authors"
        }
      },
      "raw_snapshot_path": "data/raw/web/pdbe_entries/{pdb_id}.json",
      "extraction_status": "pending"
    }
  ]
}